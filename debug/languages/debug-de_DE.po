msgid "Invalid backup file."
msgstr "Ungültige Sicherungsdatei."

msgid "Backup file not found."
msgstr "Sicherungsdatei nicht gefunden."

msgid "Could not delete backup file. Check file permissions."
msgstr "Sicherungsdatei konnte nicht gelöscht werden. Überprüfen Sie die Dateiberechtigungen."

msgid "Backup file is not a valid wp-config.php."
msgstr "Die Sicherungsdatei ist keine gültige wp-config.php."

msgid "Could not restore wp-config.php. Check file permissions."
msgstr "wp-config.php konnte nicht wiederhergestellt werden. Überprüfen Sie die Dateiberechtigungen."

msgid "File debug.log not removed."
msgstr "Die Datei debug.log wurde nicht entfernt."

msgid "debug.log file removed successfully."
msgstr "Die Datei debug.log wurde erfolgreich entfernt."

msgid "Security check failed. Please try again."
msgstr "Sicherheitsprüfung fehlgeschlagen. Bitte versuchen Sie es erneut."

msgid "You do not have permission to change debug settings."
msgstr "Sie haben keine Berechtigung, die Debug-Einstellungen zu ändern."

msgid "Please enter a valid email address."
msgstr "Bitte geben Sie eine gültige E-Mail-Adresse ein."

msgid "Settings saved successfully."
msgstr "Einstellungen erfolgreich gespeichert."

msgid "A backup of wp-config.php was created: %s"
msgstr "Eine Sicherung von wp-config.php wurde erstellt: %s"

msgid "wp-config.php was not found."
msgstr "wp-config.php wurde nicht gefunden."

msgid "Could not read wp-config.php."
msgstr "wp-config.php konnte nicht gelesen werden."

msgid "wp-config.php is not writable. Copy the code below into your wp-config.php file:"
msgstr "wp-config.php ist nicht beschreibbar. Kopieren Sie den folgenden Code in Ihre wp-config.php-Datei:"

msgid "Could not write wp-config.php."
msgstr "wp-config.php konnte nicht geschrieben werden."

msgid "Error on %s (via Debug)"
msgstr "Fehler auf %s (über Debug)"

msgid "Error Reporting"
msgstr "Fehlerberichterstattung"

