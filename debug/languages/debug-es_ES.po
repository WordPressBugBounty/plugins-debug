msgid "Invalid backup file."
msgstr "Archivo de respaldo no válido."

msgid "Backup file not found."
msgstr "No se encontró el archivo de respaldo."

msgid "Could not delete backup file. Check file permissions."
msgstr "No se pudo eliminar el archivo de respaldo. Verifique los permisos del archivo."

msgid "Backup file is not a valid wp-config.php."
msgstr "El archivo de respaldo no es un wp-config.php válido."

msgid "Could not restore wp-config.php. Check file permissions."
msgstr "No se pudo restaurar wp-config.php. Verifique los permisos del archivo."

msgid "File debug.log not removed."
msgstr "El archivo debug.log no se eliminó."

msgid "debug.log file removed successfully."
msgstr "El archivo debug.log se eliminó correctamente."

msgid "Security check failed. Please try again."
msgstr "Falló la verificación de seguridad. Inténtelo de nuevo."

msgid "You do not have permission to change debug settings."
msgstr "No tiene permiso para cambiar los ajustes de depuración."

msgid "Please enter a valid email address."
msgstr "Ingrese una dirección de correo electrónico válida."

msgid "Settings saved successfully."
msgstr "Ajustes guardados correctamente."

msgid "A backup of wp-config.php was created: %s"
msgstr "Se creó un respaldo de wp-config.php: %s"

msgid "wp-config.php was not found."
msgstr "No se encontró wp-config.php."

msgid "Could not read wp-config.php."
msgstr "No se pudo leer wp-config.php."

msgid "wp-config.php is not writable. Copy the code below into your wp-config.php file:"
msgstr "wp-config.php no es escribible. Copie el código siguiente en su archivo wp-config.php:"

msgid "Could not write wp-config.php."
msgstr "No se pudo escribir wp-config.php."

msgid "Error on %s (via Debug)"
msgstr "Error en %s (vía Depurador)"

