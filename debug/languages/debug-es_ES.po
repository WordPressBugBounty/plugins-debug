msgstr "Contexto:"

msgid "Please enter a valid notification email address first."
msgstr "Ingrese primero una dirección de correo de notificación válida."

msgid "Please enable Email Notification before sending a test."
msgstr "Active la notificación por correo antes de enviar una prueba."

msgid "Test notification from Debug on %s"
msgstr "Notificación de prueba de Depurador en %s"

msgid "This is a test notification."
msgstr "Esta es una notificación de prueba."

msgid "Time:"
msgstr "Hora:"

msgid "Status:"
msgstr "Estado:"

msgid "Debug plugin email notifications are working."
msgstr "Las notificaciones por correo del complemento Depurador funcionan."

msgid "Could not send the test notification. Check your mail setup."
msgstr "No se pudo enviar la notificación de prueba. Verifique su configuración de correo."

msgid "You do not have permission to send a test notification."
msgstr "No tiene permiso para enviar una notificación de prueba."

msgid "Test notification sent successfully."
msgstr "Notificación de prueba enviada correctamente."

msgid "Invalid file for download."
msgstr "Archivo no válido para descargar."

msgid "File not found or unreadable."
msgstr "Archivo no encontrado o ilegible."

msgid "You do not have permission to download files."
msgstr "No tiene permiso para descargar archivos."

msgid "Security check failed."
msgstr "Falló la verificación de seguridad."

msgid "You do not have permission to manage wp-config backups."
msgstr "No tiene permiso para administrar los respaldos de wp-config."

msgid "Security check failed for restore."
msgstr "Falló la verificación de seguridad para la restauración."

msgid "Backup deleted successfully."
msgstr "Respaldo eliminado correctamente."

msgid "wp-config.php restored from backup."
msgstr "wp-config.php restaurado desde el respaldo."

msgid "Old backup pruned (kept the latest %d)."
msgid_plural "%d old backups pruned (kept the latest set)."
msgstr[0] "Respaldo antiguo eliminado (se conservó el más reciente %d)."
msgstr[1] "%d respaldos antiguos eliminados (se conservó el conjunto más reciente)."

msgid "Debug"
msgstr "Depurador"

msgid "Settings"
msgstr "Ajustes"

msgid "Error Log"
msgstr "Registro de errores"

msgid "You do not have permission to access this page."
msgstr "No tiene permiso para acceder a esta página."

msgid "Debug Settings"
msgstr "Ajustes de depuración"

msgid "Debug settings"
msgstr "Ajustes de depuración"

msgid "Enable Email Notification"
msgstr "Habilitar notificación por correo"

msgid "Email Address"
msgstr "Dirección de correo electrónico"

msgid "Enable Error Reporting"
msgstr "Habilitar informe de errores"

msgid "Create Error Log in File"
msgstr "Crear registro de errores en archivo"

msgid "Display Errors on the website"
msgstr "Mostrar errores en el sitio web"

msgid "Enable Script Debug"
msgstr "Habilitar depuración de script"

msgid "Enable Save Queries"
msgstr "Habilitar guardar consultas"

msgid "These settings update your wp-config.php file. A timestamped backup is created automatically before each save; you can restore it below."
msgstr "Estos ajustes actualizan su archivo wp-config.php. Se crea un respaldo con marca de tiempo automáticamente antes de cada guardado; puede restaurarlo abajo."

msgid "Save Changes"
msgstr "Guardar cambios"

msgid "Send Test Notification"
msgstr "Enviar notificación de prueba"

msgid "Sends a test email to verify your notification setup."
msgstr "Envía un correo de prueba para verificar su configuración de notificaciones."

msgid "wp-config.php Backups & Restore"
msgstr "Respaldos y restauración de wp-config.php"

msgid "The most recent backups are listed newest-first. Restoring returns your wp-config.php to that saved state. The latest 10 backups are kept automatically."
msgstr "Las copias de seguridad más recientes se muestran primero. Restaurar devuelve tu wp-config.php a ese estado guardado. Las 10 copias de seguridad más recientes se conservan automáticamente."

msgid "Backup file"
msgstr "Archivo de respaldo"

msgid "Action"
msgstr "Acción"

msgid "Restore"
msgstr "Restaurar"

msgid "Delete"
msgstr "Eliminar"

msgid "Debug Log"
msgstr "Registro de depuración"

msgid "Clear Log"
msgstr "Borrar registro"

msgid "Download Log"
msgstr "Descargar registro"

msgid "Auto-refresh every 5s"
msgstr "Actualizar automáticamente cada 5 s"

msgid "No Log File Found"
msgstr "No se encontró archivo de registro"

msgid "Debug your WordPress site, multisite and plugins. Debug is a development/production tool that helps you remove bugs from your WordPress website."
msgstr "Depura tu sitio WordPress, multisitio y plugins. Debug es una herramienta de desarrollo/producción que te ayuda a eliminar errores de tu sitio web WordPress."

