msgid "Invalid backup file."
msgstr "Nieprawidłowy plik kopii zapasowej."

msgid "Backup file not found."
msgstr "Nie znaleziono pliku kopii zapasowej."

msgid "Could not delete backup file. Check file permissions."
msgstr "Nie można usunąć pliku kopii zapasowej. Sprawdź uprawnienia plików."

msgid "Backup file is not a valid wp-config.php."
msgstr "Plik kopii zapasowej nie jest prawidłowym wp-config.php."

msgid "Could not restore wp-config.php. Check file permissions."
msgstr "Nie można przywrócić wp-config.php. Sprawdź uprawnienia plików."

msgid "File debug.log not removed."
msgstr "Plik debug.log nie został usunięty."

msgid "debug.log file removed successfully."
msgstr "Plik debug.log został pomyślnie usunięty."

msgid "Security check failed. Please try again."
msgstr "Kontrola bezpieczeństwa nie powiodła się. Spróbuj ponownie."

msgid "You do not have permission to change debug settings."
msgstr "Nie masz uprawnień do zmiany ustawień debugowania."

msgid "Please enter a valid email address."
msgstr "Wprowadź prawidłowy adres e-mail."

msgid "Settings saved successfully."
msgstr "Ustawienia zostały pomyślnie zapisane."

msgid "A backup of wp-config.php was created: %s"
msgstr "Utworzono kopię zapasową wp-config.php: %s"

msgid "wp-config.php was not found."
msgstr "Nie znaleziono wp-config.php."

msgid "Could not read wp-config.php."
msgstr "Nie można odczytać wp-config.php."

msgid "wp-config.php is not writable. Copy the code below into your wp-config.php file:"
msgstr "wp-config.php nie jest zapisywalny. Skopiuj poniższy kod do swojego pliku wp-config.php:"

msgid "Could not write wp-config.php."
msgstr "Nie można zapisać wp-config.php."

msgid "Error on %s (via Debug)"
msgstr "Błąd na %s (przez Debug)"

