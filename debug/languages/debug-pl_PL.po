msgid "Please enter a valid notification email address first."
msgstr "Najpierw wprowadź prawidłowy adres e-mail do powiadomień."

msgid "Please enable Email Notification before sending a test."
msgstr "Włącz powiadomienie e-mail przed wysłaniem testu."

msgid "Test notification from Debug on %s"
msgstr "Testowe powiadomienie z Debug na %s"

msgid "This is a test notification."
msgstr "To jest testowe powiadomienie."

msgid "Time:"
msgstr "Czas:"

msgid "Status:"
msgstr "Status:"

msgid "Debug plugin email notifications are working."
msgstr "Powiadomienia e-mail wtyczki Debug działają."

msgid "Could not send the test notification. Check your mail setup."
msgstr "Nie można wysłać testowego powiadomienia. Sprawdź konfigurację poczty."

msgid "You do not have permission to send a test notification."
msgstr "Nie masz uprawnień do wysyłania testowych powiadomień."

msgid "Test notification sent successfully."
msgstr "Testowe powiadomienie wysłano pomyślnie."

msgid "Invalid file for download."
msgstr "Nieprawidłowy plik do pobrania."

msgid "File not found or unreadable."
msgstr "Plik nie został znaleziony lub jest nieczytelny."

msgid "You do not have permission to download files."
msgstr "Nie masz uprawnień do pobierania plików."

msgid "Security check failed."
msgstr "Kontrola bezpieczeństwa nie powiodła się."

msgid "You do not have permission to manage wp-config backups."
msgstr "Nie masz uprawnień do zarządzania kopiami zapasowymi wp-config."

msgid "Security check failed for restore."
msgstr "Kontrola bezpieczeństwa dla przywracania nie powiodła się."

msgid "Backup deleted successfully."
msgstr "Kopia zapasowa została pomyślnie usunięta."

msgid "wp-config.php restored from backup."
msgstr "wp-config.php przywrócony z kopii zapasowej."

msgid "Old backup pruned (kept the latest %d)."
msgid_plural "%d old backups pruned (kept the latest set)."
msgstr[0] "Usunięto starą kopię zapasową (zachowano najnowszą %d)."
msgstr[1] "Usunięto %d starych kopii zapasowych (zachowano najnowszy zestaw)."

msgid "Debug"
msgstr "Debug"

msgid "Settings"
msgstr "Ustawienia"

msgid "Error Log"
msgstr "Dziennik błędów"

msgid "You do not have permission to access this page."
msgstr "Nie masz uprawnień, aby uzyskać dostęp do tej strony."

