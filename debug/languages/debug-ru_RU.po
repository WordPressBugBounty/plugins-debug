msgid "Invalid backup file."
msgstr "Недопустимый файл резервной копии."

msgid "Backup file not found."
msgstr "Файл резервной копии не найден."

msgid "Could not delete backup file. Check file permissions."
msgstr "Не удалось удалить файл резервной копии. Проверьте права доступа к файлу."

msgid "Backup file is not a valid wp-config.php."
msgstr "Файл резервной копии не является допустимым wp-config.php."

msgid "Could not restore wp-config.php. Check file permissions."
msgstr "Не удалось восстановить wp-config.php. Проверьте права доступа к файлу."

msgid "File debug.log not removed."
msgstr "Файл debug.log не удалён."

msgid "debug.log file removed successfully."
msgstr "Файл debug.log успешно удалён."

msgid "Security check failed. Please try again."
msgstr "Проверка безопасности не удалась. Попробуйте ещё раз."

msgid "You do not have permission to change debug settings."
msgstr "У вас нет разрешения изменять настройки отладки."

msgid "Please enter a valid email address."
msgstr "Пожалуйста, введите действительный адрес электронной почты."

msgid "Settings saved successfully."
msgstr "Настройки успешно сохранены."

msgid "A backup of wp-config.php was created: %s"
msgstr "Создана резервная копия wp-config.php: %s"

msgid "wp-config.php was not found."
msgstr "wp-config.php не найден."

msgid "Could not read wp-config.php."
msgstr "Не удалось прочитать wp-config.php."

msgid "wp-config.php is not writable. Copy the code below into your wp-config.php file:"
msgstr "wp-config.php недоступен для записи. Скопируйте приведённый ниже код в свой файл wp-config.php:"

msgid "Could not write wp-config.php."
msgstr "Не удалось записать wp-config.php."

msgid "Error on %s (via Debug)"
msgstr "Ошибка на %s (через Отладка)"

msgid "Error Reporting"
msgstr "Отчёт об ошибках"

