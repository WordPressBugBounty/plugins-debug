msgid "Invalid backup file."
msgstr "Geçersiz yedek dosyası."

msgid "Backup file not found."
msgstr "Yedek dosyası bulunamadı."

msgid "Could not delete backup file. Check file permissions."
msgstr "Yedek dosyası silinemedi. Dosya izinlerini kontrol edin."

msgid "Backup file is not a valid wp-config.php."
msgstr "Yedek dosyası geçerli bir wp-config.php değil."

msgid "Could not restore wp-config.php. Check file permissions."
msgstr "wp-config.php geri yüklenemedi. Dosya izinlerini kontrol edin."

msgid "File debug.log not removed."
msgstr "debug.log dosyası silinmedi."

msgid "debug.log file removed successfully."
msgstr "debug.log dosyası başarıyla silindi."

msgid "Security check failed. Please try again."
msgstr "Güvenlik kontrolü başarısız oldu. Lütfen tekrar deneyin."

msgid "You do not have permission to change debug settings."
msgstr "Hata ayıklama ayarlarını değiştirme izniniz yok."

msgid "Please enter a valid email address."
msgstr "Lütfen geçerli bir e-posta adresi girin."

msgid "Settings saved successfully."
msgstr "Ayarlar başarıyla kaydedildi."

msgid "A backup of wp-config.php was created: %s"
msgstr "wp-config.php yedeği oluşturuldu: %s"

msgid "wp-config.php was not found."
msgstr "wp-config.php bulunamadı."

msgid "Could not read wp-config.php."
msgstr "wp-config.php okunamadı."

msgid "wp-config.php is not writable. Copy the code below into your wp-config.php file:"
msgstr "wp-config.php yazılabilir değil. Aşağıdaki kodu wp-config.php dosyanıza kopyalayın:"

msgid "Could not write wp-config.php."
msgstr "wp-config.php yazılamadı."

msgid "Error on %s (via Debug)"
msgstr "%s üzerinde hata (Hata Ayıklama ile)"

msgid "Error Reporting"
msgstr "Hata Raporlama"

