msgstr "Anda tidak memiliki izin untuk mengunduh file."

msgid "Security check failed."
msgstr "Pemeriksaan keamanan gagal."

msgid "You do not have permission to manage wp-config backups."
msgstr "Anda tidak memiliki izin untuk mengelola cadangan wp-config."

msgid "Security check failed for restore."
msgstr "Pemeriksaan keamanan untuk pemulihan gagal."

msgid "Backup deleted successfully."
msgstr "Cadangan berhasil dihapus."

msgid "wp-config.php restored from backup."
msgstr "wp-config.php dipulihkan dari cadangan."

msgid "Old backup pruned (kept the latest %d)."
msgid_plural "%d old backups pruned (kept the latest set)."
msgstr[0] "Cadangan lama dipangkas (menyimpan yang terbaru %d)."
