msgstr "wp-config.php tidak ditemukan."

msgid "Could not read wp-config.php."
msgstr "Tidak dapat membaca wp-config.php."

msgid "wp-config.php is not writable. Copy the code below into your wp-config.php file:"
msgstr "wp-config.php tidak dapat ditulis. Salin kode di bawah ini ke file wp-config.php Anda:"

msgid "Could not write wp-config.php."
msgstr "Tidak dapat menulis wp-config.php."

