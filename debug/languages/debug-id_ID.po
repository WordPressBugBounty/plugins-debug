msgid "Invalid backup file."
msgstr "File cadangan tidak valid."

msgid "Backup file not found."
msgstr "File cadangan tidak ditemukan."

msgid "Could not delete backup file. Check file permissions."
msgstr "Tidak dapat menghapus file cadangan. Periksa izin file."

msgid "Backup file is not a valid wp-config.php."
msgstr "File cadangan bukan wp-config.php yang valid."

msgid "Could not restore wp-config.php. Check file permissions."
msgstr "Tidak dapat memulihkan wp-config.php. Periksa izin file."

msgid "File debug.log not removed."
msgstr "File debug.log tidak dihapus."

msgid "debug.log file removed successfully."
msgstr "File debug.log berhasil dihapus."

msgid "Security check failed. Please try again."
msgstr "Pemeriksaan keamanan gagal. Silakan coba lagi."

msgid "You do not have permission to change debug settings."
msgstr "Anda tidak memiliki izin untuk mengubah pengaturan debug."

msgid "Please enter a valid email address."
msgstr "Masukkan alamat email yang valid."

msgid "Settings saved successfully."
msgstr "Pengaturan berhasil disimpan."

