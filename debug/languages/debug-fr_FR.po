msgid "Invalid backup file."
msgstr "Fichier de sauvegarde non valide."

msgid "Backup file not found."
msgstr "Fichier de sauvegarde introuvable."

msgid "Could not delete backup file. Check file permissions."
msgstr "Impossible de supprimer le fichier de sauvegarde. Vérifiez les permissions des fichiers."

msgid "Backup file is not a valid wp-config.php."
msgstr "Le fichier de sauvegarde n'est pas un wp-config.php valide."

msgid "Could not restore wp-config.php. Check file permissions."
msgstr "Impossible de restaurer wp-config.php. Vérifiez les permissions des fichiers."

msgid "File debug.log not removed."
msgstr "Le fichier debug.log n'a pas été supprimé."

msgid "debug.log file removed successfully."
msgstr "Le fichier debug.log a été supprimé avec succès."

msgid "Security check failed. Please try again."
msgstr "Le contrôle de sécurité a échoué. Veuillez réessayer."

msgid "You do not have permission to change debug settings."
msgstr "Vous n'avez pas la permission de modifier les réglages de débogage."

msgid "Please enter a valid email address."
msgstr "Veuillez saisir une adresse e-mail valide."

msgid "Settings saved successfully."
msgstr "Réglages enregistrés avec succès."

msgid "A backup of wp-config.php was created: %s"
msgstr "Une sauvegarde de wp-config.php a été créée : %s"

msgid "wp-config.php was not found."
msgstr "wp-config.php introuvable."

msgid "Could not read wp-config.php."
msgstr "Impossible de lire wp-config.php."

msgid "wp-config.php is not writable. Copy the code below into your wp-config.php file:"
msgstr "wp-config.php n'est pas inscriptible. Copiez le code ci-dessous dans votre fichier wp-config.php :"

msgid "Could not write wp-config.php."
msgstr "Impossible d'écrire wp-config.php."

