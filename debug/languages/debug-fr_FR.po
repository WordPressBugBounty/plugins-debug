msgid "Please enter a valid notification email address first."
msgstr "Veuillez d'abord saisir une adresse e-mail de notification valide."

msgid "Please enable Email Notification before sending a test."
msgstr "Activez la notification par e-mail avant d'envoyer un test."

msgid "Test notification from Debug on %s"
msgstr "Notification de test de Débuggage sur %s"

msgid "This is a test notification."
msgstr "Ceci est une notification de test."

msgid "Time:"
msgstr "Heure :"

msgid "Status:"
msgstr "Statut :"

msgid "Debug plugin email notifications are working."
msgstr "Les notifications par e-mail du plugin Débuggage fonctionnent."

msgid "Could not send the test notification. Check your mail setup."
msgstr "Impossible d'envoyer la notification de test. Vérifiez votre configuration e-mail."

msgid "You do not have permission to send a test notification."
msgstr "Vous n'avez pas la permission d'envoyer une notification de test."

msgid "Test notification sent successfully."
msgstr "Notification de test envoyée avec succès."

msgid "Invalid file for download."
msgstr "Fichier non valide pour le téléchargement."

msgid "File not found or unreadable."
msgstr "Fichier introuvable ou illisible."

msgid "You do not have permission to download files."
msgstr "Vous n'avez pas la permission de télécharger des fichiers."

msgid "Security check failed."
msgstr "Le contrôle de sécurité a échoué."

msgid "You do not have permission to manage wp-config backups."
msgstr "Vous n'avez pas la permission de gérer les sauvegardes wp-config."

msgid "Security check failed for restore."
msgstr "Le contrôle de sécurité a échoué pour la restauration."

msgid "Backup deleted successfully."
msgstr "Sauvegarde supprimée avec succès."

msgid "wp-config.php restored from backup."
msgstr "wp-config.php restauré depuis la sauvegarde."

msgid "Old backup pruned (kept the latest %d)."
msgid_plural "%d old backups pruned (kept the latest set)."
msgstr[0] "Ancienne sauvegarde supprimée (la plus récente %d conservée)."
msgstr[1] "%d anciennes sauvegardes supprimées (le plus récent jeu conservé)."

