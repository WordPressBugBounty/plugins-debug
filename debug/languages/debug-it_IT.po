msgstr "Inserisci prima un indirizzo email di notifica valido."

msgid "Please enable Email Notification before sending a test."
msgstr "Abilita la notifica via email prima di inviare un test."

msgid "Test notification from Debug on %s"
msgstr "Notifica di prova da Debug su %s"

msgid "This is a test notification."
msgstr "Questa è una notifica di prova."

msgid "Time:"
msgstr "Ora:"

