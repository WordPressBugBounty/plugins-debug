msgstr "Stato:"

msgid "Debug plugin email notifications are working."
msgstr "Le notifiche via email del plugin Debug funzionano."

msgid "Could not send the test notification. Check your mail setup."
msgstr "Impossibile inviare la notifica di prova. Controlla la configurazione email."

msgid "You do not have permission to send a test notification."
msgstr "Non hai il permesso di inviare una notifica di prova."

msgid "Test notification sent successfully."
msgstr "Notifica di prova inviata correttamente."

msgid "Invalid file for download."
msgstr "File non valido per il download."

msgid "File not found or unreadable."
msgstr "File non trovato o illeggibile."

msgid "You do not have permission to download files."
msgstr "Non hai il permesso di scaricare file."

msgid "Security check failed."
msgstr "Controllo di sicurezza non riuscito."

msgid "You do not have permission to manage wp-config backups."
msgstr "Non hai il permesso di gestire i backup di wp-config."

