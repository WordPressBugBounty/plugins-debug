msgid "Invalid backup file."
msgstr "File di backup non valido."

msgid "Backup file not found."
msgstr "File di backup non trovato."

msgid "Could not delete backup file. Check file permissions."
msgstr "Impossibile eliminare il file di backup. Controlla i permessi dei file."

msgid "Backup file is not a valid wp-config.php."
msgstr "Il file di backup non è un wp-config.php valido."

msgid "Could not restore wp-config.php. Check file permissions."
msgstr "Impossibile ripristinare wp-config.php. Controlla i permessi dei file."

msgid "File debug.log not removed."
msgstr "Il file debug.log non è stato rimosso."

msgid "debug.log file removed successfully."
msgstr "Il file debug.log è stato rimosso correttamente."

msgid "Security check failed. Please try again."
msgstr "Controllo di sicurezza non riuscito. Riprova."

msgid "You do not have permission to change debug settings."
msgstr "Non hai il permesso di modificare le impostazioni di debug."

msgid "Please enter a valid email address."
msgstr "Inserisci un indirizzo email valido."

msgid "Settings saved successfully."
msgstr "Impostazioni salvate correttamente."

msgid "A backup of wp-config.php was created: %s"
msgstr "È stato creato un backup di wp-config.php: %s"

msgid "wp-config.php was not found."
msgstr "wp-config.php non è stato trovato."

msgid "Could not read wp-config.php."
msgstr "Impossibile leggere wp-config.php."

msgid "wp-config.php is not writable. Copy the code below into your wp-config.php file:"
msgstr "wp-config.php non è scrivibile. Copia il codice seguente nel tuo file wp-config.php:"

msgid "Could not write wp-config.php."
msgstr "Impossibile scrivere wp-config.php."

