msgstr "Controllo di sicurezza non riuscito per il ripristino."

msgid "Backup deleted successfully."
msgstr "Backup eliminato correttamente."

msgid "wp-config.php restored from backup."
msgstr "wp-config.php ripristinato dal backup."

msgid "Old backup pruned (kept the latest %d)."
msgid_plural "%d old backups pruned (kept the latest set)."
msgstr[0] "Vecchio backup rimosso (conservato il più recente %d)."
